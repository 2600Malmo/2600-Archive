---
layout: null
permalink: /search.json
search_exclude: true
---
[
{%- assign month_notes = "" | split: "," -%}
{%- for month_page in site.pages -%}
  {%- assign note_text = month_page.content | strip -%}
  {%- if month_page.layout == 'month' and note_text != empty -%}
    {%- assign month_notes = month_notes | push: month_page -%}
  {%- endif -%}
{%- endfor -%}
{%- assign combined = site.talks | concat: month_notes -%}
{%- for item in combined -%}
{
  "title": {{ item.title | default: item.month_name | default: item.name | remove: ".md" | jsonify }},
  "url": {{ item.url | relative_url | jsonify }},
  "month": {{ item.month_name | default: "" | jsonify }},
  "speaker": {{ item.speaker | default: "" | jsonify }},
  "tags": {{ item.tags | join: " " | default: "" | jsonify }},
  "content": {{ item.content | strip_html | strip_newlines | normalize_whitespace | truncate: 600 | jsonify }}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
